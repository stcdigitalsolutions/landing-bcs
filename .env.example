# Configuração do WhatsApp
# Formato: código do país + DDD + número (sem espaços ou caracteres especiais)
# Exemplo Brasil: 5511999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=5511999999999

# Configuração do Banco de Dados Neon
# Obtenha a connection string no dashboard do Neon: https://console.neon.tech
# Formato: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=postgresql://user:password@host.neon.tech/database?sslmode=require

# Configuração do NextAuth
# 📖 TUTORIAL COMPLETO: Veja TUTORIAL_GOOGLE_OAUTH.md para passo a passo detalhado
# 
# Resumo rápido:
# 1. Acesse: https://console.cloud.google.com/
# 2. Crie um projeto
# 3. Configure a Tela de Consentimento OAuth (tipo: Externo)
# 4. Crie credenciais OAuth 2.0 (tipo: Aplicativo da Web)
# 5. Adicione URI de redirecionamento: http://localhost:3000/api/auth/callback/google
# 6. Gere AUTH_SECRET: openssl rand -base64 32
# 7. Preencha as variáveis abaixo com os valores obtidos
AUTH_SECRET=seu_secret_aqui_gerado_aleatoriamente
GOOGLE_CLIENT_ID=seu_google_client_id
GOOGLE_CLIENT_SECRET=seu_google_client_secret

# Emails permitidos para acesso ao admin (separados por vírgula)
# Se não configurado, permite acesso a todos os emails (apenas para desenvolvimento)
# Exemplo: ALLOWED_EMAILS=outro@email.com,terceiro@email.com
ALLOWED_EMAILS=outro@email.com
